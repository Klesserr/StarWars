@model IEnumerable<StarWars.Models.People>

@{
	ViewData["Title"] = "Jedi";
	Layout = "~/Views/Shared/_NavLayout.cshtml";
}

<body>
	<div class="container">
		<table class="table">
			<tr>
				<th class="table-primary">@Html.DisplayNameFor(m => m.Name)</th>
				<th class="table-primary">@Html.DisplayNameFor(m => m.LaserSword)</th>
				<th class="table-primary">@Html.DisplayNameFor(m => m.Order)</th>
				<th class="table-primary">@Html.DisplayNameFor(m => m.Race)</th>
				<th class="table-primary">@Html.DisplayNameFor(m => m.PlanetName)</th>
				<th class="table-primary">@Html.DisplayNameFor(m => m.StarshipsList)</th>
				<th class="table-primary">@Html.DisplayNameFor(m => m.Gender)</th>
				<th class="table-primary">@Html.DisplayNameFor(m => m.Hair_Color)</th>
				<th class="table-primary">@Html.DisplayNameFor(m => m.Skin_Color)</th>
				<th class="table-primary">@Html.DisplayNameFor(m => m.Mass)</th>
				<th class="table-primary">@Html.DisplayNameFor(m => m.Height)</th>
				<th class="table-primary">@Html.DisplayNameFor(m => m.HomeWorld)</th>
			</tr>

			@foreach (var i in Model)
			{
				<tr>
					<td>@Html.DisplayFor(m => i.Name)</td>
					<td>@Html.DisplayFor(m => i.LaserSword)</td>
					<td>@Html.DisplayFor(m => i.Order)</td>
					<td>@Html.DisplayFor(m => i.Race)</td>
					<td>@Html.DisplayFor(m => i.PlanetName)</td>
					<td>@Html.DisplayFor(m => i.StarshipsList)</td>
					<td>@Html.DisplayFor(m => i.Gender)</td>
					<td>@Html.DisplayFor(m => i.Hair_Color)</td>
					<td>@Html.DisplayFor(m => i.Skin_Color)</td>
					<td>@Html.DisplayFor(m => i.Mass)</td>
					<td>@Html.DisplayFor(m => i.Height)</td>
					<td>@Html.DisplayFor(m => i.HomeWorld)</td>
				</tr>
			}

		</table>
	</div>
	<div>
		<a asp-controller="Home" asp-action="Index">Volver al Inicio</a>
		<br />
	</div>
</body>

