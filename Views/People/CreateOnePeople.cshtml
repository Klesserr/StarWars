@model People

@{
	ViewData["Title"] = "Crear Personaje";
	Layout = "~/Views/Shared/_NavLayout.cshtml";
	
}

<h2>Crear Personaje</h2>
<form asp-action="CreateOnePeople" method="post">
	
	<label asp-for="Name" class="form-label">
		<strong>Nombre</strong>
		<input asp-for="Name" class="form-control" />
	</label>
	<br />
	<br />
	<label asp-for="LaserSword" class="form-label">
		Color de sable
		<select asp-for="LaserSword" asp-items="@Html.GetEnumSelectList<Laser>();" name="LaserSword" >
			<option value="" >Color</option>
		</select>
	</label>
	<br />
	<br />
	<label asp-for="Race" class="form-label">
		Elige una Raza:
		<select asp-for="Race" asp-items="@Html.GetEnumSelectList<Race>();" name="Race" id="Race">
			<option value="">Seleciona el tipo</option>
		</select>
	</label>
	<br />
	<br />

	<label asp-for="Order" class="form-label">
		Orden
		<select asp-for="Order" asp-items="@Html.GetEnumSelectList<Order>()" name="Order" id="Order">
			<option value="" selected="">Orden</option>
		</select>
	</label>
	<br />
	<br />
	<label asp-for="PlanetName" class="form-label">
		Planeta
		<select asp-for="PlanetName" name="PlanetName" id="PlanetName">
			<option value="">Selecciona un planeta</option>
			@foreach(var name in ViewBag.PlanetName){
				<option value="@name">@name</option>
			}
		</select>
	</label>
	<br />
	<br />
	<label asp-for="StarshipsList" class="form-label">
		 Nave
		<select asp-for="StarshipsList" name="StarshpsList">
			<option value="">Selecciona una nave</option>
			@foreach(var name in ViewBag.StarshipName)
			{
				<option value="@name">@name</option>
			}
		</select>
	</label> 
	<br />
	<label asp-for="Gender" class="form-label">
		Género
		<input asp-for="Gender" type="text"  class="form-control"/>
	</label>
	<br />
	<label asp-for="Hair_Color" class="form-label">
		Color Pelo
		<input asp-for="Hair_Color" type="text"  class="form-control"/>
	</label>
	<br />
	<label asp-for="Skin_Color" class="form-label">
		Color Piel
		<input asp-for="Skin_Color" type="text"  class="form-control"/>
	</label>
	<br />
	<label asp-for="Mass" class="form-label">
		Masa
		<input asp-for="Mass" type="text"  class="form-control" />
	</label>
	<br />
	<label asp-for="Height" class="form-label">
		Peso
		<input asp-for="Height" type="text"  class="form-control" />
	</label>
	
	<br />
	<input type="submit" value="Crear" class="boton-borrar-editar btn5" />

</form>
<div>
	<a asp-action="Index">Back to List</a>
</div>

@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}
