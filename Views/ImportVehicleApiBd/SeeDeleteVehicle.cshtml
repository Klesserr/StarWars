@model StarWars.Models.Vehicle
@{
	Layout = "~/Views/Shared/_NavLayout.cshtml";
	ViewData["Title"] = "Delete Page";
}
<body class="text-center">
	<h4>El siguiente vehiculo va a ser borrado</h4>
	<form asp-action="DeleteOneVehicle" asp-route-nameVehicle="@Model.Name" method="post">

		<div class="container">
			<label asp-for="@Model.Name">
				<strong>Nombre</strong> <br />
				<input asp-for="Name" type="text" value="@Model.Name" readonly class="form-control-plaintext" />
			</label>
		</div>
		<br />

		<div class="container">

			<label asp-for="@Model.Model">
				<strong>Modelo</strong><br />
				<input value="@Model.Model" type="text" asp-for="Model" readonly class="form-control-plaintext" />
			</label>

		</div>
		<br />

		<div class="container">
			<label asp-for="@Model.Manufacturer">
				<strong>Fabricación</strong>
				<input type="text" value="@Model.Manufacturer" asp-for="Manufacturer" readonly class="form-control-plaintext" />
			</label>
		</div>
		<br />

		<div class="container">
			<label asp-for="@Model.VehicleClass">
				<strong>Clase</strong>
				<input readonly class="form-control-plaintext" value="@Model.VehicleClass" type="text" asp-for="VehicleClass"/>
			</label>
		</div>
		<br />

		<button type="button" class="boton-borrar-editar btn2" data-bs-toggle="modal" data-bs-target="#staticBackdrop">Borrar Vehiculo </button>

		<div class="modal fade" id="staticBackdrop" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
			<div class="modal-dialog">
				<div class="modal-content">
					<div class="modal-header">
						<h1 class="modal-title fs-5" id="staticBackdropLabel">El vehiculo va a ser destruido</h1>
						<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
					</div>
					<div class="modal-body">
						Pulsa aceptar para borrar el vehiculo
					</div>
					<div class="modal-footer">
						<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
						<input type="submit" value="Aceptar" class="boton-borrar-editar btn2" />
					</div>
				</div>
			</div>
		</div>

	</form>
	<div class="container">
		<a asp-controller="Home" asp-action="Index">Volver al Inicio</a><br />
		<a asp-controller="ImportVehicleApiBd" asp-action="MainPage">Volver al listado de Vehiculos</a>
	</div>
</body>